# Copy to .env and fill in what you have. Every key is optional: the studio
# checks what is configured and falls back instead of failing.

# --- Script writing + picking clip moments (Claude) -------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium

# --- Voiceover (first one configured wins; TTS_PROVIDER forces a choice) -----
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# TTS_PROVIDER=elevenlabs

# --- OpenAI: voiceover fallback, AI images, avatar portraits, transcription --
OPENAI_API_KEY=
# OPENAI_TTS_VOICE=nova
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Talking avatars (UGC creator on camera) ---------------------------------
# HeyGen needs a voice id; HEYGEN_AVATAR_ID lets you skip the presenter photo.
HEYGEN_API_KEY=
HEYGEN_VOICE_ID=
# HEYGEN_AVATAR_ID=
# or D-ID (uses the presenter photo + a Microsoft neural voice)
DID_API_KEY=
# DID_VOICE_ID=en-US-JennyNeural
# AVATAR_PROVIDER=heygen

# --- Stream clipper ----------------------------------------------------------
# Page links (YouTube, Twitch, Kick, X) need yt-dlp installed on the server.
# YTDLP_PATH=/usr/local/bin/yt-dlp
# CLIP_MAX_SOURCE_SECONDS=14400

# --- Rendering / server ------------------------------------------------------
# PORT=3001
# DATA_DIR=./data
# FFMPEG_PATH=            # defaults to the bundled ffmpeg-static binary
# FONTS_DIR=/usr/share/fonts
# CAPTION_FONT=DejaVu Sans
# RENDER_CONCURRENCY=1
# MAX_UPLOAD_MB=4096
